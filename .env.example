# Backend LLM provider
# mock keeps the demo deterministic and does not require any API key.
# Options: mock, spark, openai_compatible, openai, deepseek, qwen, dashscope
LLM_PROVIDER=mock
LLM_TIMEOUT_SECONDS=20

# iFLYTEK Spark / 科大讯飞星火
# Fill these when LLM_PROVIDER=spark.
SPARK_APP_ID=
SPARK_API_KEY=
SPARK_API_SECRET=
SPARK_MODEL=generalv3.5
SPARK_API_URL=https://spark-api.xf-yun.com/v3.5/chat

# OpenAI-compatible providers
# Use this for OpenAI, DeepSeek, Qwen/DashScope compatible mode, or an internal gateway.
# Examples:
#   OpenAI:    OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
#   DeepSeek: OPENAI_COMPATIBLE_BASE_URL=https://api.deepseek.com
#   DashScope compatible mode: OPENAI_COMPATIBLE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_MODEL=

# Primary database
# For production/demo with external services, use MySQL as the durable store.
# Leave empty to use the local SQLite fallback.
# Example: mysql+pymysql://a3:password@127.0.0.1:3306/a3_learning?charset=utf8mb4
MYSQL_URL=

# Optional Redis cache
# Set to redis://127.0.0.1:6379/0 to cache generation job progress and Agent Trace snapshots.
REDIS_URL=

# Frontend
VITE_API_BASE=
